# ── MetaAPI ───────────────────────────────────────────────────────────────────
META_TOKEN=your-metaapi-token
META_ACC_ID=your-metaapi-account-id
META_REGION=new-york

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ictbot

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── Bot Configuration ────────────────────────────────────────────────────────
BOT_SYMBOL=XAUUSD
BOT_CURRENCY=R
BOT_RISK=1
BOT_DD=5
BOT_MAX_TRADES=1
BOT_MIN_SCORE=7
BOT_MODE=normal
BOT_SECRET_KEY=your-secret-key

# ── Server Configuration ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── Optional: Redis for caching ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── New in v32.0: Dry-run mode (no real orders) ─────────────────────────────
DRY_RUN=false

# ── New in v32.0: File paths for persistent state (overrides /tmp defaults) ─
JOURNAL_PATH=/tmp/ict_trade_journal.json
ZONE_MEMORY_FILE=/tmp/zone_memory.json
TP_FIX_STATE_FILE=/tmp/tp_fix_state.json
SEASONALITY_FILE=/tmp/seasonality.json
AB_TESTING_FILE=/tmp/ab_testing.json
ERROR_CACHE_FILE=/tmp/error_cache.json

# ── New in v32.0: External API keys for enhanced signals ────────────────────
NEWS_API_KEY=your_news_api_key
COT_API_KEY=your_cot_api_key
