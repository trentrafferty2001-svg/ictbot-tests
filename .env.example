# Copy to .env (never commit .env). quantlab reads these from the environment.
# MetaApi (read-only use for /costs; demo orders only if QUANTLAB_EXECUTION=metaapi_demo)
META_TOKEN=
META_ACC_ID=
META_REGION=new-york
# Execution for IBS demo mode: "paper" (default, no orders at all) or "metaapi_demo".
# metaapi_demo also requires QUANTLAB_DEMO_ACC_ID == META_ACC_ID and MetaApi must
# report the account as ACCOUNT_TRADE_MODE_DEMO. There is no setting for real orders.
QUANTLAB_EXECUTION=paper
QUANTLAB_DEMO_ACC_ID=
# QQQ 5-minute prices for the forward log (https://twelvedata.com, free key)
TWELVEDATA_API_KEY=
# Use a SEPARATE Telegram bot from the live bot: two programs can't both poll one bot.
QUANTLAB_TELEGRAM_TOKEN=
QUANTLAB_TELEGRAM_CHAT_ID=
# Where logs and state are written (default ./quantlab_data, git-ignored)
QUANTLAB_HOME=
